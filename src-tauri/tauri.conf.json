{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "civicnet-wallet",
  "version": "0.1.0",
  "identifier": "com.civiclight.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CivicNet Wallet",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/civicnet-node"
    ]
  }
}
